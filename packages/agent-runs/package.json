{
  "name": "@opslane/agent-runs",
  "version": "0.0.1",
  "private": true,
  "description": "Provider-neutral run log schemas, logger and adapters for agent runs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
