{
  "name": "@opslane/worker",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.scripts.json && mkdir -p dist/narrative/frames && cp src/narrative/frames/harness.html dist/narrative/frames/",
    "start": "node dist/index.js",
    "backfill:tickets": "node dist/bin/backfill-tickets.js",
    "reset:tickets": "node dist/bin/reset-friction-tickets.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "^0.135.0",
    "@arizeai/openinference-instrumentation-anthropic": "^0.2.11",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@langfuse/otel": "^5.10.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opslane/agent-core": "workspace:*",
    "@opslane/sdk": "workspace:*",
    "@opslane/shared": "workspace:*",
    "e2b": "2.56.0",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "rrweb": "2.1.7",
    "zod": "4.6.7",
    "@opslane/agent-runs": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
